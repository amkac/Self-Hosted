# Generate at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxx

STATE_LOCATION=/volume1/docker/tailscale

# Accept DNS settings pushed by the tailnet (MagicDNS).
# Set to true only if you want Tailscale to manage the container's resolver.
TS_ACCEPT_DNS=false

# Subnet-router mode: advertise your LAN to the tailnet so remote devices
# can reach LAN-only services (router admin, NAS apps on local IPs, etc.).
# After bringing up, approve the route in the Tailscale admin console:
#   https://login.tailscale.com/admin/machines  ->  click NAS  ->  "Subnet routes"
TS_ROUTES=192.168.1.0/24

# Extra flags. Common combinations:
#   --accept-routes                         (use routes other nodes advertise)
#   --advertise-exit-node                   (let remote devices route the internet through NAS)
#   --accept-routes --advertise-exit-node   (both)
TS_EXTRA_ARGS=--accept-routes

